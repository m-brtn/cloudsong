{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "host-tools",
      "displayName": "macOS shader compiler and asset cooker for the iOS builds",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "QUENCH_HEADLESS": "ON" }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "QUENCH_HOST_SHADERC": "${sourceDir}/build/host-tools/_deps/quench-build/quench_shaderc",
        "QUENCH_HOST_COOK": "${sourceDir}/build/host-tools/_deps/quench-build/quench_cook"
      }
    },
    {
      "name": "ios-sim-release",
      "displayName": "iOS Simulator Release (build host-tools first)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    },
    {
      "name": "ios-xcode",
      "displayName": "iOS device, Xcode project with Automatic signing (-DQUENCH_IOS_TEAM=<team>; build host-tools first)",
      "inherits": "ios-base",
      "generator": "Xcode",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphoneos" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "host-tools", "configurePreset": "host-tools", "targets": ["quench_shaderc", "quench_cook"] },
    { "name": "ios-sim-release", "configurePreset": "ios-sim-release" },
    {
      "name": "ios-xcode",
      "configurePreset": "ios-xcode",
      "configuration": "Release",
      "nativeToolOptions": ["-allowProvisioningUpdates"]
    }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
